
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_ROOTFS_TARGZ=y

# EFI支持:
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_VMDK_IMAGES=n



# ===== N4100-4L 定制（基于 2026-11-23 对现网路由器的只读盘点）=====
# Kwrt 默认已带，无需重复：luci-app-advancedplus/upnp/firewall/wizard/fan、bash htop nano curl
#   wget-ssl zram-swap kmod-tcp-bbr autocore coremark、网卡 kmod-*；luci-i18n-* 由 LUCI_LANG 自动带出

# --- 代理 / 分流
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_proxychains-ng=y

# --- 组网（第一阶段仍用 wireguard-go，故意不加 kmod-wireguard / luci-proto-wireguard）
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_luci-app-openvpn=y
CONFIG_PACKAGE_openvpn-openssl=y
CONFIG_PACKAGE_openvpn-easy-rsa=y

# --- 容器 / 存储 / 共享
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_wsdd2=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-fileassistant=y
CONFIG_PACKAGE_luci-app-partexp=y

# --- 网络服务
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_luci-app-parentcontrol=y

# --- 运维（luci-app-supervisord 不依赖 supervisor，必须显式选）
CONFIG_PACKAGE_supervisor=y
CONFIG_PACKAGE_luci-app-supervisord=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_python3=y
CONFIG_PACKAGE_python3-pip=y
CONFIG_PACKAGE_btop=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_lsof=y

# --- 明确不要（现网没有 QEMU 实例在跑）
# CONFIG_PACKAGE_qemu-x86_64-softmmu is not set
# CONFIG_PACKAGE_qemu-bridge-helper is not set
# CONFIG_PACKAGE_kmod-kvm-intel is not set
# CONFIG_PACKAGE_kmod-nbd is not set
